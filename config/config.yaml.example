reality:
  media_id: 123456789
  vlive_id: "your-vlive-id"
  gid: "your-gid"
  auth: "Bearer your-token"

ai:
  llm:
    api_base: "https://api.openai.com/v1"
    api_key: "sk-xxx"
    model: "gpt-4o"
    temperature: 0.7
    max_tokens: 8192
    timeout: 30

  tts:
    enabled: false          # Enable TTS for bot responses
    voice: "alloy"          # Voice: alloy, echo, fable, onyx, nova, shimmer, or Edge TTS voices
    volume: 1.0             # Audio playback volume (0.0-1.0)
    speed: 1.0              # Speech speed (0.25-4.0, 1.0 = normal)
    model: "tts-1"          # TTS model: tts-1, tts-1-hd, gpt-4o-mini-tts
    instructions: null      # Voice instructions (only for gpt-4o-mini-tts)
    response_types: ["chat"]  # Which response types to speak: chat, gift, like, follow, join, fallback, manual
    api_base: null          # Optional: override LLM endpoint
    api_key: null           # Optional: override LLM API key
    timeout: 30             # API request timeout in seconds

  asr:
    api_base: null          # Optional: override LLM endpoint
    api_key: null           # Optional: override LLM API key
    model: "whisper-1"      # ASR model
    timeout: 30             # API request timeout in seconds


adb:
  host: "127.0.0.1"
  port: 5555
  input_box: [540, 1800] # [x, y]
  send_button: [980, 1800] # [x, y]
  auto_send: true
  send_delay: [1.0, 3.0] # [min_seconds, max_seconds]

bot:
  nickname: "RTAR Assistant"
  response_rate: 1.0
  context_length: 20
  vlive_id: "bots-vlive-id-or-fallback-to-reality.vlive_id"

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
log_level: "WARNING"
